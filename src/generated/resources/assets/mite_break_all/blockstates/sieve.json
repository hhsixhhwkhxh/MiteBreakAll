{
  "multipart": [
    {
      "apply": {
        "model": "mite_break_all:block/sieve/sieve"
      }
    },
    {
      "apply": {
        "model": "mite_break_all:block/sieve/mesh_leather"
      },
      "when": {
        "mesh_type": "leather"
      }
    },
    {
      "apply": {
        "model": "mite_break_all:block/sieve/mesh_string"
      },
      "when": {
        "mesh_type": "string"
      }
    },
    {
      "apply": {
        "model": "mite_break_all:block/sieve/gravel_layer1"
      },
      "when": {
        "gravel_level": "1"
      }
    },
    {
      "apply": {
        "model": "mite_break_all:block/sieve/gravel_layer2"
      },
      "when": {
        "gravel_level": "2"
      }
    },
    {
      "apply": {
        "model": "mite_break_all:block/sieve/gravel_layer3"
      },
      "when": {
        "gravel_level": "3"
      }
    },
    {
      "apply": {
        "model": "mite_break_all:block/sieve/gravel_layer4"
      },
      "when": {
        "gravel_level": "4"
      }
    }
  ]
}